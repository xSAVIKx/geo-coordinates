{
  "name": "geo-coordinates",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive, offline, single-file lesson about geographic coordinates for 6th graders, in English, Polish and Ukrainian.",
  "author": "Yurii Serhiichuk <yurii@serhiichuk.dev> (https://serhiichuk.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xSAVIKx/geo-coordinates.git"
  },
  "homepage": "https://xsavikx.github.io/geo-coordinates/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/size-check.ts && node --experimental-strip-types scripts/translation-review.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "shot": "node --experimental-strip-types scripts/shot.ts",
    "shots:readme": "node --experimental-strip-types scripts/readme-shots.ts",
    "brand": "node --experimental-strip-types scripts/brand-assets.ts",
    "data:regional": "node --experimental-strip-types scripts/build-regional-data.ts",
    "data:borders": "node --experimental-strip-types scripts/build-world-borders.ts",
    "data:political": "node --experimental-strip-types scripts/build-political.ts",
    "data:textures": "python3 scripts/build-textures.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^24.13.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "lineclip": "^2.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
